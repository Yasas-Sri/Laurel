# ─────────────────────────────────────────────────────────────
# Laurel environment variables
# Copy to .env.local (dev) or set in your host. Never commit real values.
# REQUIRED = app refuses to start without it. Everything else is optional with a fallback.
# Production also needs one sign-in method: SMTP email (EMAIL_PROVIDER=smtp) or Google.
# ─────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────
# REQUIRED. Public URL of the app, no trailing slash.
APP_URL=http://localhost:3000
# true on the hosted edition only (marketing site; billing UI too when BILLING_ENABLED=true)
HOSTED_MODE=false
# Logging: debug | info | warn | error
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────
# REQUIRED. Pooled connection for the app.
DATABASE_URL=postgres://laurel:laurel@localhost:5432/laurel
# Direct (unpooled) connection for migrations. Defaults to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Used by integration tests only.
TEST_DATABASE_URL=postgres://laurel:laurel@localhost:5433/laurel_test

# ── Auth (Better Auth) ──────────────────────────────────────
# REQUIRED. 32+ random chars: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Security ────────────────────────────────────────────────
# REQUIRED. 32+ random chars. Used to hash IPs for rate limiting (raw IPs are never stored).
IP_HASH_SECRET=
# REQUIRED in production. Bearer token for /api/cron/* (the daily cron). Vercel Cron sends it
# automatically. /api/jobs/* does NOT accept it (QStash signature only).
CRON_SECRET=
# Optional Cloudflare Turnstile. Without it: honeypot + timing checks only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Storage (S3-compatible, two buckets) ────────────────────
# REQUIRED. Local dev uses RustFS from docker compose (both buckets are created on startup).
S3_ENDPOINT=http://localhost:9000
# us-east-1 for RustFS; auto for R2
S3_REGION=us-east-1
# Never public. All uploads land here; unapproved media only ever lives here.
S3_BUCKET_PRIVATE=laurel-private
# Public-read. Approve copies media here; unpublish/delete removes the copy.
S3_BUCKET_PUBLIC=laurel-public
S3_ACCESS_KEY_ID=laurel
S3_SECRET_ACCESS_KEY=laurelsecret
# true for RustFS; false for R2/S3
S3_FORCE_PATH_STYLE=true
# REQUIRED. Public base URL of S3_BUCKET_PUBLIC, no trailing slash (object URL = MEDIA_PUBLIC_URL/{key}).
# Must be a different origin from APP_URL in production.
MEDIA_PUBLIC_URL=http://localhost:9000/laurel-public

# ── Email ───────────────────────────────────────────────────
# smtp | console. console prints magic links to the terminal: dev only, rejected in production.
# Empty in production = email off (Google sign-in then required; notification emails are skipped).
EMAIL_PROVIDER=smtp
EMAIL_FROM="Laurel <no-reply@example.com>"
# SMTP (local dev: Mailpit from docker compose). Amazon SES: use its SMTP endpoint, see DEPLOYMENT.md.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── Jobs ────────────────────────────────────────────────────
# Optional Upstash QStash. Without it jobs run inline after the response.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# ── Rate limiting ───────────────────────────────────────────
# Optional Upstash Redis. Without it counters are stored in Postgres (rate_limit table).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI (optional: transcripts, captions, highlights) ────────
# Any OpenAI-compatible API. Leave AI_API_KEY empty to disable AI features.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TRANSCRIBE_MODEL=whisper-1
AI_CHAT_MODEL=

# ── Billing (hosted edition only) ───────────────────────────
# true requires HOSTED_MODE=true (the app refuses to start otherwise).
# HOSTED_MODE=true + BILLING_ENABLED=false = hosted instance without plan limits.
BILLING_ENABLED=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_TEAM_MONTHLY=
LEMONSQUEEZY_VARIANT_TEAM_YEARLY=

# ── Observability ───────────────────────────────────────────
SENTRY_DSN=
# Anonymous instance ping (version + workspace count). Off by default for self-hosters.
TELEMETRY_ENABLED=false
